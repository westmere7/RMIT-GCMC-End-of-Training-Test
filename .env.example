# Copy this file to ".env" (never commit .env) and fill in the same values you gave Vercel.
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here
# Optional, for running SQL migrations: Connect → Session pooler URI (the direct db.<ref> host is IPv6-only)
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
